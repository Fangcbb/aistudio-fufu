rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == "fangcbb1@gmail.com" && 
             request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Projects Validation
    function isValidProject(data) {
      return data.keys().hasAll(['title', 'order', 'type']) &&
             data.keys().size() >= 3 &&
             data.title is string && data.title.size() <= 100 &&
             data.order is number &&
             data.type in ['portfolio', 'classification'];
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(projectId) && isValidProject(request.resource.data);
      allow update: if isAdmin() && isValidProject(request.resource.data);
      allow delete: if isAdmin();
    }

    // Gallery Validation
    function isValidGalleryImage(data) {
      return data.keys().hasAll(['title', 'url', 'order']) &&
             data.title is string && data.title.size() <= 200 &&
             data.url is string && data.url.size() <= 1000 &&
             data.order is number;
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(imageId) && isValidGalleryImage(request.resource.data);
      allow update: if isAdmin() && isValidGalleryImage(request.resource.data);
      allow delete: if isAdmin();
    }

    // Site Content Validation
    match /site_content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
